# AML Service Environment Variables

APP_NAME=aml
APP_VERSION=0.1
LOG_LEVEL=INFO

MONGODB_URL=mongodb://mongodb:27017
MONGODB_DB_NAME=aml_db

REDIS_URL=redis://redis:6379/0

# Token for calling auth-service /verify_user/{sid}
TOKEN=

# Allowlist for internal AML calls (future)
ALLOWED_TOKENS=[]

# KEK for envelope encryption (Base64, 32 bytes). Example generation:
# python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
AML_KEK_B64=

# CSRF signing secret (random string)
CSRF_SECRET=
