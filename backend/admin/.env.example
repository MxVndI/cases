# Admin Service Environment Variables

# Application settings
APP_NAME=admin
APP_VERSION=0.1
LOG_LEVEL=DEBUG
ENV_TYPE=dev

# Service URLs
CASE_SERVICE_URL=http://cases:8000
PAYMENT_SERVICE_URL=http://payment:8000
USER_SERVICE_URL=http://user:8000
AUTH_SERVICE_URL=http://auth:8000

# Inter-service authentication
TOKEN=super_secret_admin_key_123
ALLOWED_TOKENS=["super_secret_admin_key_123", "service_token_456"]
