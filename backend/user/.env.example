# User Service Environment Variables

# Application settings
APP_NAME=user
APP_VERSION=0.1
LOG_LEVEL=INFO

# Database
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DB_NAME=user_db

# Redis
REDIS_URL=redis://redis:6379/0

# Auth service URL for session verification
AUTH_SERVICE_URL=http://auth:8000

# Token for inter-service communication
TOKEN=user_service_token_789
ALLOWED_TOKENS=["super_secret_admin_key_123", "user_service_token_789"]
