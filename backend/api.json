{
  "openapi": "3.0.3",
  "info": {
    "title": "CaseHub API",
    "version": "1.3.0",
    "description": "Полная спецификация API для веб-платформы CaseHub — симулятора открытия кейсов Counter-Strike 2."
  },
  "servers": [
    {
      "url": "https://api.casehub.example.com"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "login": { "type": "string" },
          "email": { "type": "string" },
          "is_blocked": { "type": "boolean" },
          "is_admin": { "type": "boolean" },
          "registration_date": { "type": "string", "format": "date-time" }
        }
      },
      "Case": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "price": { "type": "number", "format": "float" },
          "img_link": { "type": "string" }
        }
      },
      "Item": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "rarity": { "type": "string" },
          "price": { "type": "number", "format": "float" },
          "img_link": { "type": "string" }
        }
      }
    }
  },
  "tags": [
    { "name": "Guest", "description": "Эндпоинты для неавторизованных пользователей" },
    { "name": "User", "description": "Эндпоинты для авторизованных пользователей (JWT)" },
    { "name": "Admin", "description": "Эндпоинты для администраторов (JWT + admin)" },
    { "name": "System", "description": "Интеграция с внешними системами (Steam, платежи)" }
  ],
  "paths": {
    "/users": {
      "post": {
        "tags": ["Guest"],
        "summary": "Создание пользователя",
        "description": "Регистрация нового аккаунта в системе.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "login": { "type": "string" },
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                },
                "required": ["login", "email", "password"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Пользователь успешно создан",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Guest"],
        "summary": "Авторизация пользователя",
        "description": "Вход пользователя для получения JWT.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "login": { "type": "string" },
                  "password": { "type": "string" }
                },
                "required": ["login", "password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Успешная авторизация",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": { "type": "string" },
                    "user": { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          },
          "401": { "description": "Неверный логин или пароль" }
        }
      }
    },
    "/cases": {
      "get": {
        "tags": ["Guest"],
        "summary": "Список кейсов",
        "responses": {
          "200": {
            "description": "Все доступные кейсы",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Case" } }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Admin"],
        "security": [{ "bearerAuth": [] }],
        "summary": "Создать кейс (администратор)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "price": { "type": "number" },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "item_id": { "type": "integer" },
                        "drop_chance": { "type": "number" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Кейс создан" } }
      }
    },
    "/cases/{case_id}/items": {
      "get": {
        "tags": ["Guest"],
        "summary": "Содержимое кейса",
        "parameters": [
          { "name": "case_id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Список предметов",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Item" } }
              }
            }
          }
        }
      }
    },
    "/cases/recently_opened": {
      "get": {
        "tags": ["Guest"],
        "summary": "Последние открытия кейсов",
        "responses": {
          "200": {
            "description": "Список последних открытий",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "userLogin": { "type": "string" },
                      "itemName": { "type": "string" },
                      "caseName": { "type": "string" },
                      "openedAt": { "type": "string", "format": "date-time" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/users/{userId}/password": {
      "post": {
        "tags": ["User"],
        "security": [{ "bearerAuth": [] }],
        "summary": "Изменить пароль",
        "parameters": [
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "newPassword": { "type": "string" } } } } }
        },
        "responses": { "200": { "description": "Пароль успешно обновлен" } }
      }
    },
    "/users/{userId}/login": {
      "post": {
        "tags": ["User"],
        "security": [{ "bearerAuth": [] }],
        "summary": "Изменить логин",
        "parameters": [
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "newLogin": { "type": "string" } } } } }
        },
        "responses": {
          "200": { "description": "Логин успешно изменён" },
          "400": { "description": "Логин уже занят" }
        }
      }
    },
    "/users/me": {
      "get": {
        "tags": ["User"],
        "security": [{ "bearerAuth": [] }],
        "summary": "Получить профиль текущего пользователя",
        "responses": {
          "200": {
            "description": "Данные пользователя, баланс и инвентарь",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": { "$ref": "#/components/schemas/User" },
                    "balance": { "type": "number" },
                    "inventory": { "type": "array", "items": { "$ref": "#/components/schemas/Item" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/cases/{case_id}/open": {
      "post": {
        "tags": ["User"],
        "security": [{ "bearerAuth": [] }],
        "summary": "Открыть кейс",
        "parameters": [
          { "name": "case_id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "201": {
            "description": "Кейс открыт успешно",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "item": { "$ref": "#/components/schemas/Item" }
                  }
                }
              }
            }
          },
          "400": { "description": "Недостаточно средств" }
        }
      }
    },
    "/user_inventory/{userId}": {
      "get": {
        "tags": ["User"],
        "security": [{ "bearerAuth": [] }],
        "summary": "Получить инвентарь",
        "parameters": [
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Инвентарь пользователя",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Item" } }
              }
            }
          }
        }
      }
    },
    "/user_inventory/{itemId}/sell": {
      "post": {
        "tags": ["User"],
        "security": [{ "bearerAuth": [] }],
        "summary": "Продать предмет",
        "parameters": [
          { "name": "itemId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Предмет продан, баланс обновлён" } }
      }
    },
    "/user_inventory/{itemId}/withdraw": {
      "post": {
        "tags": ["User"],
        "security": [{ "bearerAuth": [] }],
        "summary": "Вывод предмета через Steam",
        "parameters": [
          { "name": "itemId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Запрос на вывод создан" },
          "400": { "description": "Trade Link отсутствует" }
        }
      }
    },
    "/admin/users": {
      "get": {
        "tags": ["Admin"],
        "security": [{ "bearerAuth": [] }],
        "summary": "Просмотр всех пользователей",
        "responses": {
          "200": {
            "description": "Список всех пользователей",
            "content": {
              "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/User" } } }
            }
          }
        }
      }
    },
    "/admin/users/{userId}": {
      "get": {
        "tags": ["Admin"],
        "security": [{ "bearerAuth": [] }],
        "summary": "Просмотр профиля пользователя по ID",
        "parameters": [
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Профиль пользователя",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          },
          "404": { "description": "Пользователь не найден" }
        }
      },
      "post": {
        "tags": ["Admin"],
        "security": [{ "bearerAuth": [] }],
        "summary": "Блокировка или разблокировка пользователя",
        "parameters": [
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "type": "object", "properties": { "block": { "type": "boolean" } } } }
          }
        },
        "responses": {
          "200": { "description": "Статус блокировки обновлён" },
          "404": { "description": "Пользователь не найден" }
        }
      }
    },
    "/admin/users/login/{login}": {
      "get": {
        "tags": ["Admin"],
        "security": [{ "bearerAuth": [] }],
        "summary": "Получение профиля пользователя по логину",
        "parameters": [
          { "name": "login", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Профиль пользователя", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } },
          "404": { "description": "Пользователь не найден" }
        }
      }
    },
    "/admin/users/id/{userId}/login": {
      "get": {
        "tags": ["Admin"],
        "security": [{ "bearerAuth": [] }],
        "summary": "Получение логина пользователя по ID",
        "parameters": [
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Логин пользователя",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "login": { "type": "string" } } }
              }
            }
          },
          "404": { "description": "Пользователь не найден" }
        }
      }
    },
    "/payments/callback": {
      "post": {
        "tags": ["System"],
        "summary": "Уведомление от платёжной системы",
        "description": "Получает уведомление об успешном платеже и обновляет баланс пользователя.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "userId": { "type": "integer" },
                  "amount": { "type": "number" },
                  "status": { "type": "string", "enum": ["completed", "failed"] }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Платёж обработан" } }
      }
    },
    "/steam/trade": {
      "post": {
        "tags": ["System"],
        "summary": "Отправка предмета в Steam",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "userId": { "type": "integer" },
                  "itemId": { "type": "integer" },
                  "tradeLink": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Обмен успешно создан" },
          "400": { "description": "Ошибка Steam API" }
        }
      }
    }
  }
}
