# Payment Service Environment Variables (Rust)

# Database
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DB_NAME=payment_db

# Auth service URL for user verification
AUTH_SERVICE_URL=http://auth:8000

# Token for inter-service communication
TOKEN=payment_service_token_def
ALLOWED_TOKENS=["super_secret_admin_key_123", "payment_service_token_def"]

# Server
HOST=0.0.0.0
PORT=8000
