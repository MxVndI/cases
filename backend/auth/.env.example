# Auth Service Environment Variables

# Application settings
APP_NAME=auth
APP_VERSION=0.1
LOG_LEVEL=INFO

# Database
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DB_NAME=auth_db

# Redis
REDIS_URL=redis://redis:6379/0

# OAuth providers (configure as needed)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://auth:8000/auth/discord/callback

# Email authentication
SMTP_SERVER=
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_STARTTLS=true
SMTP_TIMEOUT_S=10
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# Token for inter-service communication
TOKEN=auth_service_token_xyz
ALLOWED_TOKENS=["super_secret_admin_key_123", "auth_service_token_xyz"]

# Frontend & cookie settings
FRONTEND_URL=http://localhost:5173
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# User service URL (for HTTP inter-service calls)
USER_SERVICE_URL=http://userservice:8000
