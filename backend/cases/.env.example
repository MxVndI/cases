# Cases Service Environment Variables

# Application settings
APP_NAME=cases
APP_VERSION=0.1
LOG_LEVEL=INFO

# Database
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DB_NAME=cases_db

# Redis
REDIS_URL=redis://redis:6379/0

# Auth service URL for user verification
AUTH_SERVICE_URL=http://auth:8000

# Token for inter-service communication
TOKEN=cases_service_token_abc
ALLOWED_TOKENS=["super_secret_admin_key_123", "cases_service_token_abc"]
